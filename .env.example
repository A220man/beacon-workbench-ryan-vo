# Beacon Workbench Environment Configuration
# Copy this file to .env and fill in the values

# App
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./beacon.db
DATABASE_ECHO=false

# Security (REQUIRED in production - generate with: openssl rand -hex 32)
SECRET_KEY=development-secret-key-change-in-production-min-32-chars
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/beacon
OIDC_CLIENT_ID=beacon-workbench
OIDC_CLIENT_SECRET=beacon-workbench-secret-change-in-production
OIDC_AUDIENCE=beacon-workbench-api

# CORS
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# LLM (Optional - for AI-powered features)
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...